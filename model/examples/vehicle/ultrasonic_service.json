{
  "schema": "openautosar.example.ultrasonic.v1",
  "service": {
    "name": "UltrasonicDistanceService",
    "instance": "/OpenAUTOSAR/Vehicle/Ultrasonic/FrontCenter",
    "events": [
      {
        "name": "DistanceSample",
        "e2e": {
          "profile": "profile01",
          "data_id": 2768343041,
          "counter_bits": 8,
          "max_delta_counter": 1,
          "timeout_ms": 100,
          "max_repetitions": 0
        },
        "fields": [
          {
            "name": "distance_mm",
            "type": "uint16"
          },
          {
            "name": "alive_counter",
            "type": "uint8"
          },
          {
            "name": "valid",
            "type": "bool"
          }
        ]
      }
    ]
  }
}
