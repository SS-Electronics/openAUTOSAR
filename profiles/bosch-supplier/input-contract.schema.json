{
  "license": "SPDX-License-Identifier: MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openautosar.local/profiles/bosch-supplier/input-contract.schema.json",
  "title": "Bosch Supplier Adapter Input Contract Template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_contract_id",
    "release_schema",
    "authorized_inputs",
    "quality_gates"
  ],
  "properties": {
    "project_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "release_schema": {
      "type": "string",
      "minLength": 1
    },
    "authorized_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
